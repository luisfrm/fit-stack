---
import { cva } from "class-variance-authority";
import SrOnly from "./SrOnly.astro";

/**
 * Feature checklist used by pricing cards and feature lists.
 * Icons are rendered here so pages never decide the visual.
 */
const list = cva("flex flex-col", {
  variants: {
    gap: {
      sm: "gap-2",
      md: "gap-3",
    },
    size: {
      sm: "text-sm",
      base: "text-base",
    },
  },
  defaultVariants: {
    gap: "sm",
    size: "sm",
  },
});

const row = cva("flex items-start gap-2");

const icon = cva("mt-0.5 size-4 shrink-0", {
  variants: {
    included: {
      true: "text-primary-ink",
      false: "text-foreground-dim",
    },
  },
  defaultVariants: { included: true },
});

const label = cva("", {
  variants: {
    included: {
      true: "text-foreground",
      false: "text-foreground-muted",
    },
  },
  defaultVariants: { included: true },
});

interface Item {
  readonly label: string;
  readonly included?: boolean;
}

interface Props {
  items: readonly Item[];
  gap?: "sm" | "md";
  size?: "sm" | "base";
}

const { items, gap, size } = Astro.props;
---

<ul class={list({ gap, size })}>
  {
    items.map((item) => {
      const included = item.included !== false;
      return (
        <li class={row()}>
          <svg
            class={icon({ included })}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {included ? <path d="M20 6 9 17l-5-5" /> : <path d="M18 6 6 18M6 6l12 12" />}
          </svg>
          <span class={label({ included })}>
            <SrOnly>{included ? "Incluye: " : "No incluye: "}</SrOnly>
            {item.label}
          </span>
        </li>
      );
    })
  }
</ul>
