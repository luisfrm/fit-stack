---
import { Icon as AstroIcon } from "astro-icon/components";
import { cva } from "class-variance-authority";

const icon = cva("", {
  variants: {
    size: {
      xs: "size-3.5",
      sm: "size-4",
      md: "size-5",
      lg: "size-6",
      xl: "size-8",
    },
    tone: {
      inherit: "",
      primary: "text-primary-ink",
      muted: "text-foreground-muted",
      dim: "text-foreground-dim",
      success: "text-success",
      info: "text-info",
      warning: "text-warning",
      destructive: "text-destructive",
      foreground: "text-foreground",
    },
    shrink: {
      true: "shrink-0",
      false: "",
    },
  },
  defaultVariants: {
    size: "md",
    tone: "inherit",
    shrink: false,
  },
});

interface Props {
  /** Iconify name, e.g. `lucide:check`. */
  name: string;
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  tone?:
    | "inherit"
    | "primary"
    | "muted"
    | "dim"
    | "success"
    | "info"
    | "warning"
    | "destructive"
    | "foreground";
  shrink?: boolean;
  /** Provide only when the icon carries meaning on its own. */
  label?: string;
}

const { name, size, tone, shrink, label } = Astro.props;
---

<AstroIcon
  name={name}
  class={icon({ size, tone, shrink })}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
/>
