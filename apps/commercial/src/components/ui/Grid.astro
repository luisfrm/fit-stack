---
import { cva } from "class-variance-authority";

const grid = cva("grid", {
  variants: {
    cols: {
      1: "grid-cols-1",
      2: "grid-cols-1 md:grid-cols-2",
      3: "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
      /** Three compact items that stack only on the smallest screens. */
      threeUp: "grid-cols-1 sm:grid-cols-3",
      4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
      auto: "grid-cols-[repeat(auto-fit,minmax(16rem,1fr))]",
    },
    gap: {
      sm: "gap-4",
      md: "gap-6",
      lg: "gap-8",
      xl: "gap-12",
    },
    align: {
      stretch: "items-stretch",
      start: "items-start",
      center: "items-center",
    },
    /** Editorial split: content first, illustration second. */
    split: {
      true: "lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16",
      /** Wide primary column plus a narrow, top-aligned sidebar (legal pages). */
      aside: "lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start lg:gap-12",
      /** Wide primary column plus a narrow, top-aligned secondary column (forms). */
      form: "lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-start lg:gap-12",
      false: "",
    },
  },
  defaultVariants: {
    cols: 3,
    gap: "md",
    align: "stretch",
    split: false,
  },
});

interface Props {
  as?: "div" | "ul" | "ol";
  cols?: 1 | 2 | 3 | "threeUp" | 4 | "auto";
  gap?: "sm" | "md" | "lg" | "xl";
  align?: "stretch" | "start" | "center";
  split?: boolean | "aside" | "form";
}

const { as: Tag = "div", cols, gap, align, split } = Astro.props;
---

<Tag class={grid({ cols, gap, align, split })}>
  <slot />
</Tag>
