---
import { cva } from "class-variance-authority";

const card = cva("rounded-xl border transition-colors duration-200", {
  variants: {
    tone: {
      surface: "border-border bg-card shadow-card",
      flat: "border-border-muted bg-surface-2/40",
      glass: "border-border bg-glass-bg backdrop-blur-md",
      outline: "border-border bg-transparent",
      primary: "border-primary/40 bg-primary-soft",
    },
    padding: {
      none: "",
      sm: "p-4",
      md: "p-6",
      lg: "p-8",
    },
    interactive: {
      true: "hover:border-primary/40 hover:bg-card",
      false: "",
    },
    featured: {
      true: "border-primary/60 ring-1 ring-primary/20",
      false: "",
    },
  },
  defaultVariants: {
    tone: "surface",
    padding: "md",
    interactive: false,
    featured: false,
  },
});

interface Props {
  as?: "div" | "article" | "li" | "section";
  tone?: "surface" | "flat" | "glass" | "outline" | "primary";
  padding?: "none" | "sm" | "md" | "lg";
  interactive?: boolean;
  featured?: boolean;
}

const { as: Tag = "div", tone, padding, interactive, featured } = Astro.props;
---

<Tag class={card({ tone, padding, interactive, featured })}>
  <slot />
</Tag>
