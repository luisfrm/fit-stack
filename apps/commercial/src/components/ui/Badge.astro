---
import { cva } from "class-variance-authority";

const badge = cva(
  "inline-flex items-center gap-1.5 rounded-full border font-bold uppercase",
  {
    variants: {
      tone: {
        default: "border-border bg-surface-2/70 text-foreground-muted",
        primary: "border-primary/40 bg-primary-soft text-primary-ink",
        success: "border-success/30 bg-success/10 text-success",
        outline: "border-border bg-transparent text-foreground-muted",
      },
      size: {
        sm: "px-3 py-1 text-[0.6875rem] tracking-[0.14em]",
        md: "px-4 py-1.5 text-xs tracking-[0.16em]",
      },
    },
    defaultVariants: {
      tone: "default",
      size: "sm",
    },
  }
);

interface Props {
  tone?: "default" | "primary" | "success" | "outline";
  size?: "sm" | "md";
}

const { tone, size } = Astro.props;
---

<span class={badge({ tone, size })}>
  <slot />
</span>
