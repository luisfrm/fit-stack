---
import { cva } from "class-variance-authority";

import { CONTACT } from "@/config/site";
import {
  formatAiCredits,
  formatPlanPrice,
  FREE_PLAN,
  PLAN_CURRENCY,
  type Plan,
} from "@/data/pricing";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import CheckList from "@/components/ui/CheckList.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Stack from "@/components/ui/Stack.astro";
import Text from "@/components/ui/Text.astro";

interface Props {
  plans: readonly Plan[];
}

const { plans } = Astro.props;

const headerRow = cva("flex items-start justify-between gap-3");
const creditsRow = cva(
  "flex items-center gap-2 rounded-md bg-primary-soft px-3 py-2 text-xs font-semibold text-primary-ink"
);
const noteRow = cva("flex items-center gap-2");

const NOTES = [
  {
    icon: "lucide:clock",
    title: "Sin periodos de prueba",
    body: "La suscripción empieza a contar con el primer pago. Si hay una promoción, llega como cupón sobre tu suscripción y no se convierte sola en un cobro.",
  },
  {
    icon: "lucide:badge-check",
    title: "Plan de precio 0",
    body: "Un plan gratuito es un plan, no una prueba: no se cobra, no genera comprobante y no vence solo. Para cuentas sin suscripción vigente existe además un piso gratuito operativo.",
  },
  {
    icon: "lucide:users",
    title: "Cupos del portal",
    body: "El cupo exacto del Portal de Miembros por plan se confirma con el equipo Fit-Stack. El personal interno nunca consume cupos: solo tus clientes.",
  },
] as const;
---

<Section id="precios" labelledBy="precios-title">
  <Stack gap="xl">
    <SectionHeader
      eyebrow="Precios"
      title="Un precio por gimnasio, no por"
      accent="miembro"
      description={`Suscripción mensual en ${PLAN_CURRENCY}, por gimnasio. Los importes de esta página son de referencia: el equipo Fit-Stack los define en la Consola y pueden cambiar, así que confirma el valor vigente al contratar.`}
      id="precios-title"
    />

    <Grid as="ul" cols={3} gap="md">
      {
        plans.map((plan) => (
          <Card as="li" padding="lg" featured={plan.highlight}>
            <Stack gap="md">
              <div class={headerRow()}>
                <Heading as="h3" size="card" flush>
                  {plan.name}
                </Heading>
                {plan.highlight && <Badge tone="primary">Recomendado</Badge>}
              </div>

              <Text size="sm" tone="muted">
                {plan.tagline}
              </Text>

              <Stack gap="none">
                <Text size="price" tone="strong">
                  {formatPlanPrice(plan.priceCents)}
                </Text>
                <Text size="xs" tone="subtle" weight="bold" uppercase>
                  Por gimnasio, al mes
                </Text>
              </Stack>

              <div class={creditsRow()}>
                <Icon name="lucide:sparkles" size="sm" shrink />
                {formatAiCredits(plan.aiCredits)} créditos IA al mes
              </div>

              <Text size="sm" tone="muted">
                {plan.description}
              </Text>

              <CheckList items={plan.features} gap="sm" size="sm" />

              <Button
                href={CONTACT.demoPath}
                variant={plan.highlight ? "primary" : "outlined"}
                size="md"
                fullWidth
              >
                Probar la demo
                <Icon name="lucide:arrow-right" size="sm" />
              </Button>
            </Stack>
          </Card>
        ))
      }
    </Grid>

    <Card tone="flat" padding="lg">
      <Stack gap="md">
        <Heading as="h3" size="sm" flush>
          Sin pruebas que se conviertan en cobro
        </Heading>

        <Grid as="ul" cols={3} gap="md">
          {
            NOTES.map((note) => (
              <Stack as="li" gap="xs">
                <div class={noteRow()}>
                  <Icon name={note.icon} size="sm" tone="primary" shrink />
                  <Text as="span" size="xs" tone="default" weight="bold" uppercase>
                    {note.title}
                  </Text>
                </div>
                <Text size="sm" tone="muted">
                  {note.body}
                </Text>
              </Stack>
            ))
          }
        </Grid>

        <Text size="xs" tone="subtle">
          El piso gratuito incluye {FREE_PLAN.portalSeats} cupos de Portal de Miembros y{" "}
          {formatAiCredits(FREE_PLAN.aiCredits)} créditos IA al mes. Todos los planes incluyen el
          panel administrativo; las diferencias están en la página web (desde el plan Standard), el
          Portal de Miembros y los créditos IA.
        </Text>
      </Stack>
    </Card>
  </Stack>
</Section>
