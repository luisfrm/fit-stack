---
import { cva } from "class-variance-authority";

import "@fontsource-variable/dm-sans";
import "@fontsource-variable/space-grotesk";
import "@/styles/global.css";

import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SEO from "@/components/seo/SEO.astro";

const body = cva("min-h-svh bg-background font-sans text-foreground antialiased");
const html = cva("scroll-smooth");
const skipLink = cva("skip-link");

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  /** Optional `data-page` hook for page-scoped styling. */
  page?: string;
}

const { title, description, image, noindex = false, type = "website", page } = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class={html()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        const KEY = "fitstack-theme";
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch {
          stored = null;
        }
        const mode = stored === "dark" || stored === "light" || stored === "system" ? stored : "light";
        const isDark =
          mode === "dark" ||
          (mode === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", isDark);
        root.dataset.theme = mode;
        root.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>

    <SEO title={title} description={description} path={path} image={image} noindex={noindex} type={type} />
    <slot name="head" />
  </head>
  <body class={body()} data-page={page}>
    <a href="#main" class={skipLink()}>Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="scripts" />
  </body>
</html>
