DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
BETTER_AUTH_URL=http://localhost:8788
BETTER_AUTH_SECRET=your_better_auth_secret
JWT_SECRET=your_jwt_secret
COOKIE_DOMAIN=.yourdomain.com

UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Workers AI (OpenAI SDK)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_AI_API_TOKEN=your_workers_ai_token
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openai

# OpenRouter (modelo gratuito automático: openrouter/free)
OPENROUTER_API_KEY=your_openrouter_api_key
