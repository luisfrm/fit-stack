{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-stack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8788"
  },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "fit-stack-files-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "fit-task-events-dev",
        "binding": "TASK_QUEUE"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "fit-stack-api-dev",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-dev"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-dev",
            "binding": "TASK_QUEUE"
          }
        ]
      }
    },
    "staging": {
      "name": "fit-stack-api-staging",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-staging",
            "binding": "TASK_QUEUE"
          }
        ]
      }
    },
    "production": {
      "name": "fit-stack-api-prod",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-prod"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-prod",
            "binding": "TASK_QUEUE"
          }
        ]
      }
    }
  }
}