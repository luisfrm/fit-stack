{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-stack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "fit-stack-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "fit-task-events",
        "binding": "TASK_QUEUE"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}