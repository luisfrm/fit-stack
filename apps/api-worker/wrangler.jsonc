{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-stack-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "fit-stack-files-dev"
    }
  ],
  "queues": {
      "producers": [
        {
          "queue": "fit-task-events-dev",
          "binding": "TASK_QUEUE"
        },
        {
          "queue": "fit-receipt-events-dev",
          "binding": "RECEIPT_QUEUE"
        }
      ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "fit-stack-api-dev",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-dev"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-dev",
            "binding": "TASK_QUEUE"
          },
          {
            "queue": "fit-receipt-events-dev",
            "binding": "RECEIPT_QUEUE"
          }
        ]
      }
    },
    "staging": {
      "name": "fit-stack-api-staging",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-staging"
        }
      ],
      "queues": {
      "producers": [
        {
          "queue": "fit-task-events-staging",
          "binding": "TASK_QUEUE"
        },
        {
          "queue": "fit-receipt-events-staging",
          "binding": "RECEIPT_QUEUE"
        }
      ]
      }
    },
    "production": {
      "name": "fit-stack-api",
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files"
        }
      ],
      "queues": {
      "producers": [
        {
          "queue": "fit-task-events",
          "binding": "TASK_QUEUE"
        },
        {
          "queue": "fit-receipt-events",
          "binding": "RECEIPT_QUEUE"
        }
      ]
      }
    }
  }
}