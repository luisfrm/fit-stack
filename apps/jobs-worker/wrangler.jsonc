{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fit-stack-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "queues": {
    "producers": [
      {
        "queue": "fit-task-events",
        "binding": "TASK_QUEUE"
      },
      {
        "queue": "fit-receipt-events",
        "binding": "RECEIPT_QUEUE"
      }
    ],
    "consumers": [
      {
        // Lightweight email events — small batches are fine.
        "queue": "fit-task-events",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "fit-task-events-dlq"
      },
      {
        // Heavy PDF render — one at a time to avoid CPU limit breaches.
        "queue": "fit-receipt-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fit-receipt-events-dlq"
      }
    ]
  },

  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "fit-stack-files"
    }
  ],

  "observability": {
    "enabled": true
  },

  "env": {
    "dev": {
      "name": "fit-stack-jobs-dev",
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-dev",
            "binding": "TASK_QUEUE"
          },
          {
            "queue": "fit-receipt-events-dev",
            "binding": "RECEIPT_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "fit-task-events-dev",
            "max_batch_size": 5,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "fit-task-events-dev-dlq"
          },
          {
            "queue": "fit-receipt-events-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "fit-receipt-events-dev-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-dev"
        }
      ]
    },
    "staging": {
      "name": "fit-stack-jobs-staging",
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events-staging",
            "binding": "TASK_QUEUE"
          },
          {
            "queue": "fit-receipt-events-staging",
            "binding": "RECEIPT_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "fit-task-events-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "fit-task-events-staging-dlq"
          },
          {
            "queue": "fit-receipt-events-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "fit-receipt-events-staging-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files-staging"
        }
      ]
    },
    "production": {
      "name": "fit-stack-jobs",
      "queues": {
        "producers": [
          {
            "queue": "fit-task-events",
            "binding": "TASK_QUEUE"
          },
          {
            "queue": "fit-receipt-events",
            "binding": "RECEIPT_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "fit-task-events",
            "max_batch_size": 5,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "fit-task-events-dlq"
          },
          {
            "queue": "fit-receipt-events",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "fit-receipt-events-dlq"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "fit-stack-files"
        }
      ]
    }
  }
}
