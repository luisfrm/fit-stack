{
  "name": "fit-stack",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo dev",
    "start:api": "pnpm --filter api-worker dev",
    "start:jobs": "pnpm --filter jobs-worker dev",
    "start:panel": "pnpm --filter panel dev",
    "start:console": "pnpm --filter console dev",
    "start:web": "pnpm --filter web dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:push": "pnpm --filter @workspace/database db:push",
    "db:pull": "pnpm --filter @workspace/database db:pull",
    "db:check": "pnpm --filter @workspace/database db:check",
    "db:studio": "pnpm --filter @workspace/database db:studio",
    "db:seed": "pnpm --filter @workspace/database db:seed",
    "typecheck": "pnpm turbo typecheck",
    "repair-db": "pnpm --filter @workspace/database exec node scripts/repair-migrations.mjs",
    "repair-db-test": "pnpm --filter @workspace/database exec node scripts/repair-test-migrations.mjs",
    "test": "pnpm --filter @workspace/shared test && pnpm --filter api-worker test && pnpm --filter panel test && pnpm --filter console test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:panel": "playwright test --project=panel",
    "test:e2e:console": "playwright test --project=console",
    "test:e2e:report": "playwright show-report",
    "seed:e2e": "tsx e2e/seed.ts"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@playwright/test": "^1.63.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/shared": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.8.1",
    "typescript": "5.9.3",
    "vitest": "^3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}